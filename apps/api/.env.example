# ---------------------------------------------------------------
# RevenuePilot API configuration. Copy to .env and adjust.
# Never commit real secrets.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Interface to bind. Defaults to 127.0.0.1 in production (only Nginx reaches the API).
# HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL connection string.
# Matches docker-compose.yml defaults; change for Homebrew/VPS installs.
DATABASE_URL=postgresql://revenuepilot:revenuepilot@localhost:5432/revenuepilot?schema=public

# Used only by `npm test`. Must point at a database whose name contains "test";
# the test suite truncates every table in it.
TEST_DATABASE_URL=postgresql://revenuepilot:revenuepilot@localhost:5432/revenuepilot_test?schema=public

# JWT signing secret: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h

# bcrypt cost factor (10-14 recommended in production).
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (the React dashboard).
CORS_ORIGINS=http://localhost:5173

# Set to 1 when running behind Nginx so client IPs are read correctly.
TRUST_PROXY=0

# Password given to the demo users created by `npm run db:seed`.
SEED_DEMO_PASSWORD=DemoPass123!

# --- AI agents ---------------------------------------------------
# auto: use Claude when ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN) is set,
#       otherwise the offline mock.  live: always Claude (the SDK can also use
#       an `ant auth login` profile).  mock: never call Claude.
AI_MODE=auto
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Leave empty for models without effort support.
AI_EFFORT=medium
AI_MAX_TOKENS=16000
# SDK retries for 429 / 5xx / connection errors (exponential backoff).
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=120000
# Maximum model round-trips per agent run.
AI_MAX_ITERATIONS=12
# Server-side refusal fallback on models that support it (1/0).
AI_REFUSAL_FALLBACK=1

# --- Follow-up automation (Redis + BullMQ) ---------------------
REDIS_URL=redis://localhost:6379
# Used only by `npm test`; must select a non-zero DB (it is flushed).
TEST_REDIS_URL=redis://localhost:6379/15
QUEUE_PREFIX=rp
WORKER_CONCURRENCY=5
# How often the worker re-checks for missing follow-ups / lost jobs (ms).
FOLLOW_UP_SWEEP_INTERVAL_MS=600000

# --- Email ------------------------------------------------------
# mock: nothing leaves the machine (development).  resend: real delivery.
EMAIL_PROVIDER=mock
# RESEND_API_KEY=re_...
# Must be on a domain verified in Resend. The business name is the display name.
EMAIL_FROM_ADDRESS=notifications@example.com
# Public URL of this API (unsubscribe links point here).
PUBLIC_BASE_URL=http://localhost:4000
# Reply-To with a per-lead token, so replies can be matched automatically.
# Requires an inbound email route that POSTs to /api/webhooks/inbound-email.
# Without it, replies go to the owner's email and should be logged via the API.
# INBOUND_REPLY_ADDRESS=replies+{token}@in.example.com
# HMAC secret shared with the inbound relay (>= 24 chars).
# INBOUND_WEBHOOK_SECRET=
# Bearer token for /ops/queues (failed-job monitoring); disabled when unset.
# OPS_TOKEN=

# --- Platform ----------------------------------------------------
# Demo features: the bundled demo website (https://evergreen-landscaping.test/)
# for Website Intelligence. Defaults to on outside production, off in production.
# DEMO_MODE=1
# Where the dashboard is served. Used for the hosted enquiry form link, embed
# code and OAuth redirects back to the dashboard.
PUBLIC_WEB_URL=http://localhost:5173
# AES-256-GCM key for integration secrets stored in the database (GoDaddy token,
# Google refresh token, webhook signing secret). REQUIRED in production.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# INTEGRATIONS_ENCRYPTION_KEY=

# --- Google Calendar (optional) ------------------------------------
# OAuth client from Google Cloud Console (Calendar API enabled). Redirect URI:
#   <PUBLIC_BASE_URL>/api/integrations/google/callback
# Without these, the built-in calendar (working hours + booked appointments) is used.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
